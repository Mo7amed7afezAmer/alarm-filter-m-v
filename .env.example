POSTGRES_USER=alarm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alarms
DATABASE_URL=postgresql://alarm:change-me@db:5432/alarms
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://<host-ip>:3000
# super admin (every office + all settings), created once by the migrate service
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
ALARM_TZ=Africa/Cairo
ALERT_HOURS=4
# optional Gmail search filter, e.g. from:alarms@vendor.com
GMAIL_QUERY=
# The worker reads the whole mailbox. A message's office = its first label under these parents
OFFICE_LABEL_PARENTS=DN,DS
# Hourly reports (CLAUDE.md §14) — on-demand, nothing stored
HOURLY_GMAIL_LABEL=Hourly Update
HOURLY_MAX_RAR_MB=25
HOURLY_MAX_EXTRACT_MB=100
HOURLY_CACHE_MIN=30
# dev/demo only: serve the .rar files in this directory instead of Gmail
HOURLY_GMAIL_MOCK_DIR=
# path to the official unrar binary (default: unrar on PATH; node-unrar-js if missing)
HOURLY_UNRAR_BIN=
