// Schema per CLAUDE.md §8. Table names are snake_case (as referenced in §5/§7).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  DOWN
  POWER
  OTHER
}

enum AlarmStatus {
  ACTIVE
  CLEARED
}

enum ClearType {
  EMAIL
  AUTO_SUPERSEDED
}

enum Role {
  VIEWER
  ADMIN
}

/// Every Gmail message seen, parseable or not. Source of truth for reprocess().
model RawMessage {
  id          Int       @id @default(autoincrement())
  gmailId     String    @unique
  subject     String
  /// Gmail internalDate. Used as clearTime for EMAIL clears (§7 B.2).
  receivedAt  DateTime
  /// Plain-text email body (alarm details incl. CONSEC_NBR, cell name). Null for old rows.
  body        String?
  parseError  String?
  processedAt DateTime?

  orphanClears OrphanClear[]

  @@index([receivedAt])
  @@map("raw_messages")
}

model Alarm {
  id          Int         @id @default(autoincrement())
  alarmKey    String
  alarmName   String
  site        String
  category    Category
  alarmTime   DateTime
  status      AlarmStatus @default(ACTIVE)
  clearTime   DateTime?
  durationMin Int?
  clearType   ClearType?
  /// From the email body: unique alarm id shared by the alarm and its Clear.
  consecNbr   String?     @unique
  cellName    String?
  device      String?
  createdAt   DateTime    @default(now())

  // Not unique any more: different cells can share alarmKey-without-cell + time; identity is consecNbr.
  @@index([alarmKey, alarmTime])
  @@index([status, category])
  @@index([site])
  @@map("alarms")
}

model OrphanClear {
  id           Int        @id @default(autoincrement())
  alarmKey     String
  subject      String
  clearTime    DateTime
  rawMessageId Int
  consecNbr    String?
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id], onDelete: Cascade)

  @@index([alarmKey])
  @@index([consecNbr])
  @@map("orphan_clears")
}

/// Classification rules (§6): first match by ascending priority wins.
model Rule {
  id       Int      @id @default(autoincrement())
  pattern  String
  category Category
  priority Int

  @@index([priority])
  @@map("rules")
}

model Site {
  site   String  @id
  region String?
  owner  String?

  @@map("sites")
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         Role   @default(VIEWER)

  @@map("users")
}

model SystemStatus {
  id              Int       @id @default(1)
  lastHistoryId   String?
  lastRunAt       DateTime?
  lastError       String?
  lastRunMessages Int       @default(0)
  reprocessDays   Int?

  @@map("system_status")
}
