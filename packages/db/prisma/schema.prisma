// Schema per CLAUDE.md §8. Table names are snake_case (as referenced in §5/§7).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  DOWN
  POWER
  OTHER
}

enum AlarmStatus {
  ACTIVE
  CLEARED
}

enum ClearType {
  EMAIL
  AUTO_SUPERSEDED
}

enum Role {
  VIEWER
  /// Viewer + may trigger on-demand processing (hourly reports).
  OPERATOR
  /// Office admin: manages the viewers/operators of their own office; sees that office only.
  ADMIN
  /// Every office, every setting (Gmail, rules, Site Master, reprocess) and every user.
  SUPER_ADMIN
}

/// Every Gmail message seen, parseable or not. Source of truth for reprocess().
model RawMessage {
  id          Int       @id @default(autoincrement())
  gmailId     String    @unique
  subject     String
  /// Gmail internalDate. Used as clearTime for EMAIL clears (§7 B.2).
  receivedAt  DateTime
  /// Plain-text email body (alarm details incl. CONSEC_NBR, cell name). Null for old rows.
  body        String?
  /// Office label of the message: its first label under OFFICE_LABEL_PARENTS (DN/, DS/),
  /// e.g. "DN/Kafr ElDawar"; null when it has none (inbox only).
  office      String?
  /// Every Gmail label of the message (display names: "INBOX", "DN/Kafr ElDawar", …).
  labels      String[]  @default([])
  parseError  String?
  processedAt DateTime?

  orphanClears OrphanClear[]

  @@index([receivedAt])
  @@index([office])
  @@map("raw_messages")
}

model Alarm {
  id          Int         @id @default(autoincrement())
  alarmKey    String
  alarmName   String
  site        String
  category    Category
  alarmTime   DateTime
  status      AlarmStatus @default(ACTIVE)
  clearTime   DateTime?
  durationMin Int?
  clearType   ClearType?
  /// From the email body: unique alarm id shared by the alarm and its Clear.
  consecNbr   String?     @unique
  cellName    String?
  device      String?
  /// Office the alarm belongs to (what every page filters on): the Site Master office of
  /// `siteCode` (mapped to its Gmail label), else `mailOffice`. Kept by resolveOffices().
  office      String?
  /// Office label of the alarm mail (raw_messages.office).
  mailOffice  String?
  /// Site code = last "_" segment of `site` (join key to site_master).
  siteCode    String?
  createdAt   DateTime    @default(now())

  // Not unique any more: different cells can share alarmKey-without-cell + time; identity is consecNbr.
  @@index([alarmKey, alarmTime])
  @@index([status, category])
  @@index([office, status])
  @@index([site])
  @@index([siteCode])
  @@map("alarms")
}

model OrphanClear {
  id           Int        @id @default(autoincrement())
  alarmKey     String
  subject      String
  clearTime    DateTime
  rawMessageId Int
  consecNbr    String?
  /// Resolved like alarms.office (Site Master first, then the mail label).
  office       String?
  mailOffice   String?
  rawMessage   RawMessage @relation(fields: [rawMessageId], references: [id], onDelete: Cascade)

  @@index([alarmKey])
  @@index([consecNbr])
  @@map("orphan_clears")
}

/// Classification rules (§6): first match by ascending priority wins.
model Rule {
  id       Int      @id @default(autoincrement())
  pattern  String
  category Category
  priority Int

  @@index([priority])
  @@map("rules")
}

model Site {
  site   String  @id
  region String?
  owner  String?

  @@map("sites")
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String
  role                Role      @default(VIEWER)
  /// VIEWER / OPERATOR / ADMIN: the office (Gmail label) this user belongs to — they see only
  /// it; null = no office yet (sees nothing). SUPER_ADMIN: the office currently viewed
  /// (null = all offices).
  office              String?
  /// Notification preferences (see packages/core/src/notify.ts). Null = defaults (DOWN only).
  notifyPrefs         Json?
  /// Notifications for alarms created after this are unread.
  notificationsSeenAt DateTime?
  /// Alarm types this user hides from THEIR pages only: { hiddenCategories, hiddenAlarmNames }.
  displayPrefs        Json?

  @@map("users")
}

model SystemStatus {
  id              Int       @id @default(1)
  lastHistoryId   String?
  lastRunAt       DateTime?
  lastError       String?
  lastRunMessages Int       @default(0)
  reprocessDays   Int?
  /// Legacy (before 2026-10-20 the worker read one office label). Unused.
  officeLabel     String?
  /// What lastHistoryId belongs to: "*" = whole mailbox. Anything else forces a fresh backfill.
  syncedLabel     String?
  /// Gmail labels offered in /settings, refreshed by the worker: [{ name }].
  availableLabels Json?
  /// Alarm types hidden from every page/stat/export (admin, /settings):
  /// { hiddenCategories: Category[], hiddenAlarmNames: string[] }. Data is still stored.
  displayFilter   Json?

  @@map("system_status")
}

/// The Gmail mailbox the worker and the hourly reports read (one row, id=1), connected from
/// /settings/gmail. Overrides credentials.json / token.json when its fields are set.
/// The refresh token is never returned by any API.
model GmailAccount {
  id           Int       @id @default(1)
  /// OAuth "Desktop app" client uploaded in the UI; null = use credentials.json.
  clientId     String?
  clientSecret String?
  /// Mailbox address (users.getProfile) of the connected account.
  email        String?
  refreshToken String?
  scope        String?
  connectedAt  DateTime?
  /// E-mail of the admin who connected it.
  connectedBy  String?
  lastCheckAt  DateTime?
  lastCheckOk  Boolean?
  lastCheckMsg String?
  updatedAt    DateTime  @updatedAt

  @@map("gmail_account")
}

/// Site enrichment for hourly reports (§14). Imported from an uploaded xlsx, upserted by code.
model SiteMaster {
  /// Site Code, e.g. "3273DE".
  code        String   @id
  siteName    String?
  office      String
  nodality    String?
  vip         Boolean  @default(false)
  siteType    String?
  powerSource String?
  battery     String?
  /// Site contact number ("Guard Number" in the SiteMaster file).
  phone       String?
  /// Last 2 chars of the code (DE, UP, AL, …).
  region      String?
  notes       String?
  updatedAt   DateTime @updatedAt

  @@index([office])
  @@map("site_master")
}

/// Value fixes applied to hourly report fields after trim/collapse/upper-case (§14).
/// field = row field name (alarmName, office, …) or "*" for every normalized field.
model HourlyNormalization {
  id    Int    @id @default(autoincrement())
  field String
  from  String
  to    String

  @@unique([field, from])
  @@map("hourly_normalizations")
}
